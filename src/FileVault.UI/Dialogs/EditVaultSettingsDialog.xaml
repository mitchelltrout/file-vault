<Window x:Class="FileVault.UI.Dialogs.EditVaultSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit vault settings"
        Background="#0a0a0a"
        Foreground="#F0F0F0"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="440"
        ResizeMode="NoResize">
  <StackPanel Margin="16">
    <TextBlock Text="Cover Image (optional)" Foreground="#888888" FontSize="11" Margin="0,0,0,4"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
      <TextBlock x:Name="CoverImagePathText" Text="(unchanged)" Width="240" VerticalAlignment="Center"
                 Foreground="#888888" TextTrimming="CharacterEllipsis"/>
      <Button Content="Browse..." Click="BrowseCover_Click" Margin="8,0,0,0" Padding="12,4"/>
      <Button Content="Remove" Click="RemoveCover_Click" Margin="4,0,0,0" Padding="12,4"/>
    </StackPanel>
    <TextBlock Text="Warning: Changing the cover rewrites the entire vault file. Don't edit the cover with other apps."
               Foreground="#888888" FontSize="11"
               Margin="0,4,0,0" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Click="Cancel_Click" Padding="16,6" MinWidth="80" Margin="0,0,8,0"/>
      <Button Content="Save" Click="Save_Click" Padding="16,6" MinWidth="80" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
