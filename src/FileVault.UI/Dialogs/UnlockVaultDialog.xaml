<Window x:Class="FileVault.UI.Dialogs.UnlockVaultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Vault"
        Background="#0a0a0a"
        Foreground="#F0F0F0"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="480"
        ResizeMode="NoResize">
  <StackPanel Margin="20">
    <TextBlock Text="Vault File" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,0,4"/>
    <DockPanel Margin="0,0,0,12">
      <Button Content="Browse…" Click="Browse_Click" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,4"/>
      <TextBox x:Name="FilePathBox" IsReadOnly="True"/>
    </DockPanel>

    <TextBlock Text="Password" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,0,4"/>
    <PasswordBox x:Name="PasswordBox" Margin="0,0,0,4"/>

    <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="11"
               Visibility="Collapsed" Margin="0,4,0,0" TextWrapping="Wrap"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Click="Cancel_Click" Padding="16,6" MinWidth="80" Margin="0,0,8,0"/>
      <Button Content="Unlock" Click="OnUnlock" Padding="16,6" MinWidth="80" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
