<Window x:Class="FileVault.UI.Dialogs.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:FileVault.UI.Dialogs"
        Title="Change Password"
        Background="#0a0a0a"
        Foreground="#F0F0F0"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="480"
        ResizeMode="NoResize">
  <StackPanel Margin="20">
    <TextBlock Text="Current Password" Foreground="#888888" FontSize="11" Margin="0,0,0,4"/>
    <PasswordBox x:Name="CurrentPasswordBox" Margin="0,0,0,12"/>

    <TextBlock Text="New Password" Foreground="#888888" FontSize="11" Margin="0,0,0,4"/>
    <PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,12"/>

    <TextBlock Text="Confirm New Password" Foreground="#888888" FontSize="11" Margin="0,0,0,4"/>
    <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,12"/>

    <TextBlock x:Name="ErrorText" Foreground="#cc4444" FontSize="11" Visibility="Collapsed" Margin="0,0,0,8"/>

    <ToggleButton x:Name="AdvancedToggle" Margin="0,4,0,0"
                  HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                  Cursor="Hand">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="AdvancedChevron" Text="&#x25B8;" Foreground="#888888"
                   FontSize="12" VerticalAlignment="Center"/>
        <TextBlock Text=" Advanced options" Foreground="#888888"
                   FontSize="12" VerticalAlignment="Center"/>
      </StackPanel>
    </ToggleButton>

    <StackPanel x:Name="AdvancedPanel" Margin="0,4,0,0">
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, ElementName=AdvancedToggle}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>
      <dialogs:PasswordGeneratorControl x:Name="Generator"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Click="Cancel_Click" Padding="16,6" MinWidth="80" Margin="0,0,8,0"/>
      <Button Content="Change Password" Click="OnSubmit" Padding="16,6" MinWidth="80" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
