<Window x:Class="FileVault.UI.Dialogs.CreateVaultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:FileVault.UI.Dialogs"
        Title="Create Vault"
        Background="#0a0a0a"
        Foreground="#F0F0F0"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="480"
        ResizeMode="NoResize">
  <StackPanel Margin="20">
    <TextBlock Text="Vault File" Foreground="#888888" FontSize="11" Margin="0,0,0,4"/>
    <DockPanel Margin="0,0,0,12">
      <Button Content="Browse…" Click="Browse_Click" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,4"/>
      <TextBox x:Name="FilePathBox" IsReadOnly="True"/>
    </DockPanel>

    <TextBlock Text="Display Name" Foreground="#888888" FontSize="11" Margin="0,0,0,4"/>
    <TextBox x:Name="DisplayNameBox" Margin="0,0,0,12"/>

    <TextBlock Text="Password" Foreground="#888888" FontSize="11" Margin="0,0,0,4"/>
    <PasswordBox x:Name="PasswordBox" Margin="0,0,0,12"/>

    <ToggleButton x:Name="AdvancedToggle" Margin="0,4,0,0"
                  HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                  Cursor="Hand">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="AdvancedChevron" Text="&#x25B8;" Foreground="#888888"
                   FontSize="12" VerticalAlignment="Center"/>
        <TextBlock Text=" Advanced options" Foreground="#888888"
                   FontSize="12" VerticalAlignment="Center"/>
      </StackPanel>
    </ToggleButton>

    <StackPanel x:Name="AdvancedPanel" Margin="0,4,0,0">
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, ElementName=AdvancedToggle}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>
      <dialogs:PasswordGeneratorControl x:Name="Generator"/>
    </StackPanel>

    <TextBlock Text="Cover Image (optional)" Foreground="#888888" FontSize="11" Margin="0,12,0,4"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
      <TextBlock x:Name="CoverImagePathText" Text="(none)" Width="280" VerticalAlignment="Center"
                 Foreground="#888888" TextTrimming="CharacterEllipsis"/>
      <Button Content="Browse…" Click="BrowseCover_Click" Margin="8,0,0,0" Padding="12,4"/>
      <Button Content="Clear" Click="ClearCover_Click" Margin="4,0,0,0" Padding="12,4"/>
    </StackPanel>
    <TextBlock Text="Warning: Don't edit the cover image with other apps — doing so will corrupt the vault."
               Foreground="#888888" FontSize="11"
               Margin="0,4,0,0" TextWrapping="Wrap"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Click="Cancel_Click" Padding="16,6" MinWidth="80" Margin="0,0,8,0"/>
      <Button Content="Create" Click="OnCreate" Padding="16,6" MinWidth="80" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
