<UserControl x:Class="FileVault.UI.Dialogs.PasswordGeneratorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="0,8">
    <!-- Mode toggle -->
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <RadioButton x:Name="RandomModeBtn" Content="Random" IsChecked="True"
                   Checked="ModeChanged" Foreground="#aaaaaa" Margin="0,0,8,0"/>
      <RadioButton x:Name="MemorableModeBtn" Content="Memorable"
                   Checked="ModeChanged" Foreground="#aaaaaa"/>
    </StackPanel>

    <!-- Random options -->
    <StackPanel x:Name="RandomOptions" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
        <TextBlock Text="Length:" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Slider x:Name="LengthSlider" Minimum="8" Maximum="128" Value="24" Width="120"
                ValueChanged="LengthSlider_Changed"/>
        <TextBlock x:Name="LengthLabel" Text="24" Foreground="#888888" VerticalAlignment="Center" Margin="8,0,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <CheckBox x:Name="UpperCheck" Content="Uppercase" IsChecked="True" Foreground="#aaaaaa" Margin="0,0,8,0"/>
        <CheckBox x:Name="LowerCheck" Content="Lowercase" IsChecked="True" Foreground="#aaaaaa" Margin="0,0,8,0"/>
        <CheckBox x:Name="NumCheck" Content="Numbers" IsChecked="True" Foreground="#aaaaaa" Margin="0,0,8,0"/>
        <CheckBox x:Name="SymCheck" Content="Symbols" IsChecked="True" Foreground="#aaaaaa"/>
      </StackPanel>
    </StackPanel>

    <!-- Memorable options (hidden by default) -->
    <StackPanel x:Name="MemorableOptions" Visibility="Collapsed" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Separator:" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="SeparatorBox" Text="$" Width="40" MaxLength="3"/>
      </StackPanel>
    </StackPanel>

    <!-- Generate button -->
    <Button Content="Generate" Click="Generate_Click" Margin="0,0,0,8" Padding="12,4"/>

    <!-- Output -->
    <TextBox x:Name="GeneratedBox" IsReadOnly="True"
             Background="#0a0a0a" Foreground="#cccccc" Margin="0,0,0,4"/>
    <TextBlock x:Name="EntropyLabel" Foreground="#555555" FontSize="11" Margin="0,0,0,4"/>
    <Button Content="Use This Password" Click="UsePassword_Click" Padding="12,4"/>
  </StackPanel>
</UserControl>
