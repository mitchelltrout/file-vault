<Window x:Class="FileVault.UI.Dialogs.DeleteConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete Items"
        Background="#0a0a0a"
        Foreground="#F0F0F0"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">
  <StackPanel Margin="20" MinWidth="380">
    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Foreground="#cccccc" Margin="0,0,0,8"/>
    <TextBlock Text="This cannot be undone." Foreground="#cc4444" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Click="Cancel_Click" Padding="16,6" MinWidth="80" Margin="0,0,8,0" IsDefault="True"/>
      <Button Content="Delete" Click="Delete_Click" Padding="16,6" MinWidth="80"/>
    </StackPanel>
  </StackPanel>
</Window>
