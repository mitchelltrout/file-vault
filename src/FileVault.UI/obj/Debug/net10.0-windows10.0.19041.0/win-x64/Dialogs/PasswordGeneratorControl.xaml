<UserControl x:Class="FileVault.UI.Dialogs.PasswordGeneratorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="8" Padding="0,8">
    <!-- Mode toggle -->
    <StackPanel Orientation="Horizontal" Spacing="8">
      <RadioButton x:ConnectionId='15' x:Name="RandomModeBtn" Content="Random" IsChecked="True"
                                         Foreground="#aaaaaa"/>
      <RadioButton x:ConnectionId='16' x:Name="MemorableModeBtn" Content="Memorable"
                                         Foreground="#aaaaaa"/>
    </StackPanel>

    <!-- Random options -->
    <StackPanel x:ConnectionId='2' x:Name="RandomOptions" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Length:" Foreground="#888888" VerticalAlignment="Center"/>
        <Slider x:ConnectionId='13' x:Name="LengthSlider" Minimum="8" Maximum="128" Value="24" Width="120"
                                                   />
        <TextBlock x:ConnectionId='14' x:Name="LengthLabel" Text="24" Foreground="#888888" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <CheckBox x:ConnectionId='9' x:Name="UpperCheck" Content="Uppercase" IsChecked="True" Foreground="#aaaaaa"/>
        <CheckBox x:ConnectionId='10' x:Name="LowerCheck" Content="Lowercase" IsChecked="True" Foreground="#aaaaaa"/>
        <CheckBox x:ConnectionId='11' x:Name="NumCheck" Content="Numbers" IsChecked="True" Foreground="#aaaaaa"/>
        <CheckBox x:ConnectionId='12' x:Name="SymCheck" Content="Symbols" IsChecked="True" Foreground="#aaaaaa"/>
      </StackPanel>
    </StackPanel>

    <!-- Memorable options (hidden by default) -->
    <StackPanel x:ConnectionId='3' x:Name="MemorableOptions" Spacing="4" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Separator:" Foreground="#888888" VerticalAlignment="Center"/>
        <TextBox x:ConnectionId='8' x:Name="SeparatorBox" Text="$" Width="40" MaxLength="3"/>
      </StackPanel>
    </StackPanel>

    <!-- Generate button -->
    <Button x:ConnectionId='4' Content="Generate"                       />

    <!-- Output -->
    <TextBox x:ConnectionId='5' x:Name="GeneratedBox" IsReadOnly="True" PlaceholderText="Generated password"
             Background="#0a0a0a" Foreground="#cccccc"/>
    <TextBlock x:ConnectionId='6' x:Name="EntropyLabel" Foreground="#555555" FontSize="11"/>
    <Button x:ConnectionId='7' Content="Use This Password"                          />
  </StackPanel>
</UserControl>

