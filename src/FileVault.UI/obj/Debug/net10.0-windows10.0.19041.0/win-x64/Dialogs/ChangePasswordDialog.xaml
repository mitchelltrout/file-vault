<ContentDialog x:ConnectionId='1' x:Class="FileVault.UI.Dialogs.ChangePasswordDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:dialogs="using:FileVault.UI.Dialogs"
               Title="Change Password"
               PrimaryButtonText="Change Password"
               CloseButtonText="Cancel"
               DefaultButton="Primary"
                                            >
  <StackPanel Spacing="12" MinWidth="400">
    <StackPanel Spacing="4">
      <TextBlock Text="Current Password" Foreground="#888888" FontSize="11"/>
      <PasswordBox x:ConnectionId='6' x:Name="CurrentPasswordBox" PlaceholderText="Current password"/>
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Text="New Password" Foreground="#888888" FontSize="11"/>
      <PasswordBox x:ConnectionId='5' x:Name="NewPasswordBox" PlaceholderText="New password"/>
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Text="Confirm New Password" Foreground="#888888" FontSize="11"/>
      <PasswordBox x:ConnectionId='4' x:Name="ConfirmPasswordBox" PlaceholderText="Confirm new password"/>
    </StackPanel>

    <TextBlock x:ConnectionId='2' x:Name="ErrorText" Foreground="#cc4444" FontSize="11" Visibility="Collapsed"/>

    <dialogs:PasswordGeneratorControl x:ConnectionId='3' x:Name="Generator"/>
  </StackPanel>
</ContentDialog>

