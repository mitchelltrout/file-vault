<ContentDialog x:Class="FileVault.UI.Dialogs.CollisionResolutionDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="File Already Exists"
               CloseButtonText="Cancel">
  <StackPanel Spacing="12">
    <TextBlock x:ConnectionId='2' x:Name="FileNameText" Foreground="#cccccc" FontWeight="SemiBold"/>
    <TextBlock Text="A file with this name already exists in the vault." Foreground="#888888"/>
    <CheckBox x:ConnectionId='3' x:Name="ApplyToAllCheck" Content="Apply to all" Foreground="#aaaaaa"/>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:ConnectionId='4' x:Name="ReplaceBtn" Content="Replace"                      />
      <Button x:ConnectionId='5' x:Name="KeepBothBtn" Content="Keep Both"                       />
      <Button x:ConnectionId='6' x:Name="SkipBtn" Content="Skip"                   />
    </StackPanel>
  </StackPanel>
</ContentDialog>

