<UserControl x:Class="FileVault.UI.Views.ListFileItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Height="32" Padding="8,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="24"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="80"/>
      <ColumnDefinition Width="120"/>
    </Grid.ColumnDefinitions>
    <FontIcon x:ConnectionId='2' Grid.Column="0" x:Name="TypeIcon" Glyph="&#xE8A5;"
              Foreground="#555555" FontSize="14"/>
    <TextBlock x:ConnectionId='3' Grid.Column="1" x:Name="NameText" Foreground="#cccccc"
               FontSize="12" VerticalAlignment="Center"
               TextTrimming="CharacterEllipsis"/>
    <TextBlock x:ConnectionId='4' Grid.Column="2" x:Name="SizeText" Foreground="#555555"
               FontSize="11" VerticalAlignment="Center"
               HorizontalAlignment="Right"/>
    <TextBlock x:ConnectionId='5' Grid.Column="3" x:Name="DateText" Foreground="#555555"
               FontSize="11" VerticalAlignment="Center"
               HorizontalAlignment="Right" Margin="8,0,0,0"/>
  </Grid>
</UserControl>

