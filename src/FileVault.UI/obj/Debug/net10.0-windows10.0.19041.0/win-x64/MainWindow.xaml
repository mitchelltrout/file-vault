<Window x:Class="FileVault.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:FileVault.UI.Views"
        Title="FileVault">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="44"/>
      <ColumnDefinition Width="Auto" MinWidth="0"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Icon Rail -->
    <Border Grid.Column="0" Background="#0a0a0a">
      <views:VaultIconRail x:ConnectionId='5' x:Name="IconRail"/>
    </Border>

    <!-- Folder Panel -->
    <Border Grid.Column="1" Background="#0a0a0a" BorderBrush="#1a1a1a" BorderThickness="0,0,1,0">
      <views:FolderPanel x:ConnectionId='4' x:Name="FolderPanelView" Width="140"/>
    </Border>

    <!-- Content Area -->
    <Grid Grid.Column="2" Background="#000000">
      <views:ContentArea x:ConnectionId='2' x:Name="ContentAreaView"/>
      <views:LockScreen x:ConnectionId='3' x:Name="LockScreenView" Visibility="Collapsed"/>
    </Grid>
  </Grid>
</Window>

