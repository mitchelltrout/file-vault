<ContentDialog x:Class="FileVault.UI.Dialogs.DeleteConfirmDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="Delete Items"
               PrimaryButtonText="Delete"
               CloseButtonText="Cancel"
               DefaultButton="Close">
  <StackPanel Spacing="8">
    <TextBlock x:ConnectionId='2' x:Name="DescriptionText" TextWrapping="Wrap" Foreground="#cccccc"/>
    <TextBlock Text="This cannot be undone." Foreground="#cc4444" FontWeight="SemiBold"/>
  </StackPanel>
</ContentDialog>

