<UserControl x:ConnectionId='1' x:Class="FileVault.UI.Views.FullscreenViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#000000"
                                     >
  <Grid>
    <ScrollViewer x:ConnectionId='2' x:Name="ImageScroller"
                  ZoomMode="Enabled" MinZoomFactor="0.5" MaxZoomFactor="8"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
      <Image x:ConnectionId='6' x:Name="MainImage" Stretch="Uniform"/>
    </ScrollViewer>

    <Button x:ConnectionId='3' x:Name="PrevButton" HorizontalAlignment="Left" VerticalAlignment="Center"
            Width="44" Height="80" Background="#44000000"
                              >
      <FontIcon Glyph="&#xE76B;" Foreground="#cccccc"/>
    </Button>

    <Button x:ConnectionId='4' x:Name="NextButton" HorizontalAlignment="Right" VerticalAlignment="Center"
            Width="44" Height="80" Background="#44000000"
                              >
      <FontIcon Glyph="&#xE76C;" Foreground="#cccccc"/>
    </Button>

    <Button x:ConnectionId='5' HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
            Background="Transparent"                    >
      <FontIcon Glyph="&#xE711;" Foreground="#888888"/>
    </Button>
  </Grid>
</UserControl>

