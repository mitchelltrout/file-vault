<UserControl x:Class="FileVault.UI.Views.GridFileItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Width="110" Height="120" Padding="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="80"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Image x:ConnectionId='2' Grid.Row="0" x:Name="ThumbImage" Stretch="UniformToFill"
           HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <FontIcon x:ConnectionId='3' Grid.Row="0" x:Name="FolderIcon" Glyph="&#xED41;"
              Foreground="#555555" FontSize="40"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Visibility="Collapsed"/>
    <TextBlock x:ConnectionId='4' Grid.Row="1" x:Name="NameText" Foreground="#cccccc"
               FontSize="11" TextTrimming="CharacterEllipsis"
               HorizontalAlignment="Center" TextAlignment="Center"/>
  </Grid>
</UserControl>

