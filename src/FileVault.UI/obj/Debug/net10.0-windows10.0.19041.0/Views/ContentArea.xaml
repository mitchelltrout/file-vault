<UserControl x:Class="FileVault.UI.Views.ContentArea"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:FileVault.UI.Views">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4"
                Background="#0a0a0a" Padding="8,0" VerticalAlignment="Center">
      <Button x:ConnectionId='5' Content="Add"                       />
      <Button x:ConnectionId='6' Content="Export"                     />
      <Button x:ConnectionId='7' Content="Delete"                     />
      <ToggleButton x:ConnectionId='8' x:Name="GridListToggle" Content="Grid"
                                                                         
                    IsChecked="True"/>
    </StackPanel>

    <!-- Grid view -->
    <GridView x:ConnectionId='2' Grid.Row="1" x:Name="FileGrid"
              SelectionMode="Multiple" Background="#000000"
                                              
                               AllowDrop="True"                         >
      <GridView.ItemTemplate>
        <DataTemplate>
          <views:GridFileItem Width="120" Height="130"/>
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>

    <!-- List view (hidden by default) -->
    <ListView x:ConnectionId='3' Grid.Row="1" x:Name="FileList"
              SelectionMode="Multiple" Background="#000000"
              Visibility="Collapsed"
                                              />
  </Grid>
</UserControl>

