<UserControl x:Class="FileVault.UI.Views.VaultIconRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:FileVault.UI.Models">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ItemsControl x:ConnectionId='2' Grid.Row="0" x:Name="VaultList">
      <ItemsControl.ItemTemplate>
        <DataTemplate                              >
          <Button x:ConnectionId='5' Width="44" Height="44" Background="Transparent"
                  HorizontalContentAlignment="Center"
                                                          >
            <TextBlock x:ConnectionId='6'                            
                       Foreground="#888888" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Button x:ConnectionId='3' Grid.Row="1" Width="44" Height="44" Background="Transparent"
            HorizontalAlignment="Center"                       >
      <FontIcon Glyph="&#xE713;" Foreground="#555555" FontSize="14"/>
    </Button>
  </Grid>
</UserControl>

