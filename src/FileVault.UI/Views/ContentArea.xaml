<UserControl x:Class="FileVault.UI.Views.ContentArea"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FileVault.UI.Views">
  <UserControl.Resources>
    <ContextMenu x:Key="ItemContextMenu">
      <MenuItem Header="Open" Click="OpenMenu_Click"/>
      <Separator/>
      <MenuItem Header="Export…" Click="Export_Click"/>
      <MenuItem Header="Rename…" Click="RenameMenu_Click"/>
      <Separator/>
      <MenuItem Header="Delete" Click="Delete_Click"/>
    </ContextMenu>
  </UserControl.Resources>
  <Grid Background="{StaticResource Surface0Brush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Border Grid.Row="0"
            Background="{StaticResource Surface1Brush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
          <Button Content="Add" Click="AddFiles_Click" Margin="0,0,6,0"/>
          <Button Content="Export" Click="Export_Click" Margin="0,0,6,0"/>
          <Button Content="Delete" Click="Delete_Click" Margin="0,0,6,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <ToggleButton x:Name="GridListToggle"
                        Checked="Toggle_Checked" Unchecked="Toggle_Unchecked"
                        Width="36" Height="28" Padding="0">
            <TextBlock x:Name="ToggleGlyph" Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets"
                       FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </ToggleButton>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Grid view: ListBox + WrapPanel -->
    <ListBox Grid.Row="1" x:Name="FileGrid"
             SelectionMode="Extended"
             Background="{StaticResource Surface0Brush}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             MouseDoubleClick="Item_DoubleClick"
             Drop="Grid_Drop" AllowDrop="True" DragOver="Grid_DragOver"
             Padding="8">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel/>
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
        <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="Margin" Value="4"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}"/>
          <EventSetter Event="PreviewMouseRightButtonDown" Handler="Item_PreviewRightDown"/>
          <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Item_PreviewLeftDown"/>
          <EventSetter Event="PreviewMouseMove" Handler="Item_PreviewMouseMove"/>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <views:GridFileItem/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- List view (hidden by default) -->
    <ListBox Grid.Row="1" x:Name="FileList"
             SelectionMode="Extended"
             Background="{StaticResource Surface0Brush}"
             Visibility="Collapsed"
             MouseDoubleClick="Item_DoubleClick"
             Drop="Grid_Drop" AllowDrop="True" DragOver="Grid_DragOver"
             Padding="0">
      <ListBox.ItemContainerStyle>
        <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="Margin" Value="0"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}"/>
          <EventSetter Event="PreviewMouseRightButtonDown" Handler="Item_PreviewRightDown"/>
          <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Item_PreviewLeftDown"/>
          <EventSetter Event="PreviewMouseMove" Handler="Item_PreviewMouseMove"/>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <views:ListFileItem/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
