<UserControl x:Class="FileVault.UI.Views.FullscreenViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF000000"
             Focusable="True"
             KeyDown="Viewer_KeyDown"
             MouseWheel="Viewer_MouseWheel">
  <Grid>
    <!-- Scrollable image host -->
    <ScrollViewer x:Name="ImageScroller"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Background="Transparent"
                  SizeChanged="ImageScroller_SizeChanged">
      <Image x:Name="MainImage" Stretch="None"
             HorizontalAlignment="Center" VerticalAlignment="Center"
             RenderTransformOrigin="0.5,0.5">
        <Image.LayoutTransform>
          <TransformGroup>
            <RotateTransform x:Name="ImageRotation" Angle="0"/>
            <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
          </TransformGroup>
        </Image.LayoutTransform>
      </Image>
    </ScrollViewer>

    <!-- Chrome toolbar (filename + close — hidden when hosted in overlay) -->
    <Border x:Name="ChromeBar" VerticalAlignment="Top" HorizontalAlignment="Stretch"
            Background="#CC000000" Padding="8" Height="44">
      <Grid>
        <TextBlock x:Name="FileNameText"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="12" VerticalAlignment="Center"
                   HorizontalAlignment="Left" Margin="8,0,0,0"/>
        <Button HorizontalAlignment="Right" Style="{StaticResource FlatButton}"
                Width="32" Height="28" Click="Close_Click" ToolTip="Close (Esc)">
          <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                     Foreground="{StaticResource TextMutedBrush}"/>
        </Button>
      </Grid>
    </Border>

    <!-- Zoom + rotate toolbar (always visible) -->
    <Border x:Name="ZoomBar" VerticalAlignment="Top" HorizontalAlignment="Right"
            Background="#CC000000" Padding="4" Height="36" Margin="0,48,0,0"
            CornerRadius="0,0,0,4">
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource FlatButton}" Width="32" Height="28"
                Click="RotateLeft_Click" ToolTip="Rotate left (Ctrl+[)">
          <TextBlock Text="&#xE80C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                     Foreground="{StaticResource TextMutedBrush}" RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform><ScaleTransform ScaleX="-1"/></TextBlock.RenderTransform>
          </TextBlock>
        </Button>
        <Button Style="{StaticResource FlatButton}" Width="32" Height="28"
                Click="RotateRight_Click" ToolTip="Rotate right (Ctrl+])">
          <TextBlock Text="&#xE80C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                     Foreground="{StaticResource TextMutedBrush}"/>
        </Button>
        <Border Width="1" Background="{StaticResource TextMutedBrush}" Margin="4,4" Opacity="0.3"/>
        <Button Style="{StaticResource FlatButton}" Width="32" Height="28"
                Click="ZoomOut_Click" ToolTip="Zoom out">
          <TextBlock Text="&#xE71F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                     Foreground="{StaticResource TextMutedBrush}"/>
        </Button>
        <TextBlock x:Name="ZoomText" Text="100%"
                   Foreground="{StaticResource TextMutedBrush}"
                   FontSize="11" VerticalAlignment="Center"
                   MinWidth="44" TextAlignment="Center"/>
        <Button Style="{StaticResource FlatButton}" Width="32" Height="28"
                Click="ZoomIn_Click" ToolTip="Zoom in">
          <TextBlock Text="&#xE8A3;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                     Foreground="{StaticResource TextMutedBrush}"/>
        </Button>
        <Button Style="{StaticResource FlatButton}" Width="32" Height="28"
                Click="FitScreen_Click" ToolTip="Fit to screen">
          <TextBlock Text="&#xE9A6;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                     Foreground="{StaticResource TextMutedBrush}"/>
        </Button>
        <Button Style="{StaticResource FlatButton}" Width="32" Height="28"
                Click="ActualSize_Click" ToolTip="Actual size (100%)">
          <TextBlock Text="1:1" FontSize="11"
                     Foreground="{StaticResource TextMutedBrush}"/>
        </Button>
      </StackPanel>
    </Border>

    <Button x:Name="PrevButton" HorizontalAlignment="Left" VerticalAlignment="Center"
            Style="{StaticResource FlatButton}"
            Width="44" Height="80" Background="#66000000"
            Click="Prev_Click">
      <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                 Foreground="{StaticResource TextPrimaryBrush}"/>
    </Button>

    <Button x:Name="NextButton" HorizontalAlignment="Right" VerticalAlignment="Center"
            Style="{StaticResource FlatButton}"
            Width="44" Height="80" Background="#66000000"
            Click="Next_Click">
      <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                 Foreground="{StaticResource TextPrimaryBrush}"/>
    </Button>
  </Grid>
</UserControl>
