<UserControl x:Class="FileVault.UI.Views.ListFileItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <local:SizeConverter xmlns:local="clr-namespace:FileVault.UI.Views" x:Key="SizeConv"/>
    <local:DateConverter xmlns:local="clr-namespace:FileVault.UI.Views" x:Key="DateConv"/>
  </UserControl.Resources>
  <Border Height="32" Padding="12,0">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="24"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="100"/>
        <ColumnDefinition Width="140"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0"
                 Text="{Binding Glyph}"
                 FontFamily="Segoe MDL2 Assets"
                 Foreground="{StaticResource TextDimBrush}"
                 FontSize="14" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1"
                 Text="{Binding Name}"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 FontSize="12" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis"/>
      <TextBlock Grid.Column="2"
                 Text="{Binding Converter={StaticResource SizeConv}}"
                 Foreground="{StaticResource TextDimBrush}"
                 FontSize="11" VerticalAlignment="Center"
                 HorizontalAlignment="Right"/>
      <TextBlock Grid.Column="3"
                 Text="{Binding ModifiedAt, Converter={StaticResource DateConv}}"
                 Foreground="{StaticResource TextDimBrush}"
                 FontSize="11" VerticalAlignment="Center"
                 HorizontalAlignment="Right" Margin="8,0,0,0"/>
    </Grid>
  </Border>
</UserControl>
