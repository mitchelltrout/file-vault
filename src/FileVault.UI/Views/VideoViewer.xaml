<UserControl x:Class="FileVault.UI.Views.VideoViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Background="Black"
             Focusable="True"
             KeyDown="OnKeyDown">
  <Grid>
    <vlc:VideoView x:Name="VideoHost" Background="Black">
      <!-- WPF content inside VideoView renders on a foreground window
           above the HWND video surface (solves the airspace problem).
           The OverlayHost grid holds both the video controls and any
           chrome injected by the parent MediaViewerOverlay. -->
      <Grid x:Name="OverlayHost" Background="Transparent">
        <!-- Bottom toolbar -->
        <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="8" Height="48">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource FlatButton}" Width="36" Height="32"
                    Click="PlayPause_Click" ToolTip="Play/Pause (Space)">
              <TextBlock x:Name="PlayPauseGlyph" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                         Foreground="{StaticResource TextPrimaryBrush}"/>
            </Button>
            <Slider Grid.Column="1" x:Name="SeekSlider" VerticalAlignment="Center" Margin="12,0,12,0"
                    Minimum="0" Maximum="100"
                    Thumb.DragStarted="SeekSlider_DragStarted"
                    Thumb.DragCompleted="SeekSlider_DragCompleted"
                    ValueChanged="SeekSlider_ValueChanged"/>
            <TextBlock Grid.Column="2" x:Name="TimeText" VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,12,0"
                       Text="00:00 / 00:00"/>
            <Slider Grid.Column="3" x:Name="VolumeSlider" Width="80" VerticalAlignment="Center"
                    Minimum="0" Maximum="100" Value="80"
                    ValueChanged="VolumeSlider_ValueChanged"/>
          </Grid>
        </Border>
      </Grid>
    </vlc:VideoView>
  </Grid>
</UserControl>
