<UserControl x:Class="FileVault.UI.Views.MediaViewerOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF000000"
             Focusable="True"
             KeyDown="OnKeyDown">
  <Grid x:Name="RootGrid">
    <!-- Inner viewer host -->
    <ContentPresenter x:Name="InnerHost"/>

    <!-- Chrome panel — visible for images, hidden for video (injected into VideoView instead) -->
    <Grid x:Name="ChromePanel">
      <!-- Header (filename + close) -->
      <Border VerticalAlignment="Top" HorizontalAlignment="Stretch"
              Background="#CC000000" Padding="8" Height="44">
        <Grid>
          <TextBlock x:Name="FileNameText"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     FontSize="12" VerticalAlignment="Center"
                     HorizontalAlignment="Left" Margin="8,0,0,0"/>
          <Button HorizontalAlignment="Right" Style="{StaticResource FlatButton}"
                  Width="32" Height="28" Click="Close_Click" ToolTip="Close (Esc)">
            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="{StaticResource TextMutedBrush}"/>
          </Button>
        </Grid>
      </Border>

      <!-- Prev / next arrows -->
      <Button HorizontalAlignment="Left" VerticalAlignment="Center"
              Style="{StaticResource FlatButton}"
              Width="44" Height="80" Background="#66000000"
              Click="Prev_Click">
        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
      </Button>
      <Button HorizontalAlignment="Right" VerticalAlignment="Center"
              Style="{StaticResource FlatButton}"
              Width="44" Height="80" Background="#66000000"
              Click="Next_Click">
        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
      </Button>
    </Grid>
  </Grid>
</UserControl>
