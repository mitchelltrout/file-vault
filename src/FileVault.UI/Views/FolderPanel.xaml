<UserControl x:Class="FileVault.UI.Views.FolderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FileVault.UI.ViewModels">
  <UserControl.Resources>
    <ContextMenu x:Key="FolderContextMenu">
      <MenuItem Header="New folder…" Click="NewFolder_Click"/>
      <MenuItem Header="Rename…" Click="RenameFolder_Click"/>
      <Separator/>
      <MenuItem Header="Delete" Click="DeleteFolder_Click"/>
    </ContextMenu>
  </UserControl.Resources>
  <Grid Background="{StaticResource Surface1Brush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="32"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <TextBlock Text="FOLDERS" FontSize="10" FontWeight="SemiBold"
                   Foreground="{StaticResource TextDimBrush}"
                   VerticalAlignment="Center" Margin="12,0"/>
        <Button Style="{StaticResource FlatButton}"
                HorizontalAlignment="Right" Width="28" Height="28"
                Click="NewRootFolder_Click"
                ToolTip="New folder">
          <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                     FontSize="12"
                     Foreground="{StaticResource TextMutedBrush}"/>
        </Button>
      </Grid>
    </Border>

    <TreeView Grid.Row="1" x:Name="FolderTree"
              Background="Transparent" BorderThickness="0"
              Padding="4,4,0,4"
              SelectedItemChanged="FolderTree_SelectedItemChanged">
      <TreeView.ItemContainerStyle>
        <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
          <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
          <Setter Property="ContextMenu" Value="{StaticResource FolderContextMenu}"/>
          <Setter Property="AllowDrop" Value="True"/>
          <EventSetter Event="Drop" Handler="FolderItem_Drop"/>
          <EventSetter Event="DragOver" Handler="FolderItem_DragOver"/>
        </Style>
      </TreeView.ItemContainerStyle>
      <TreeView.ItemTemplate>
        <HierarchicalDataTemplate DataType="{x:Type vm:FolderItemViewModel}"
                                  ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xED41;" FontFamily="Segoe MDL2 Assets"
                       FontSize="12"
                       Foreground="{StaticResource TextDimBrush}"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Name}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="12"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </HierarchicalDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </Grid>
</UserControl>
