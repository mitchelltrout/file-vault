<UserControl x:Class="FileVault.UI.Views.GridFileItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:FileVault.UI.Models">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="B2V"/>
  </UserControl.Resources>
  <Border Width="116" Height="128" Padding="4" Background="{StaticResource Surface1Brush}"
          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Thumbnail (image) -->
      <Image Grid.Row="0" Stretch="UniformToFill"
             HorizontalAlignment="Center" VerticalAlignment="Center"
             Source="{Binding Thumbnail}"
             Visibility="{Binding HasThumbnail, Converter={StaticResource B2V}, FallbackValue=Collapsed}"/>

      <!-- Placeholder glyphs (folder / image-without-thumb / video / file) -->
      <TextBlock Grid.Row="0"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontFamily="Segoe MDL2 Assets" FontSize="36"
                 Foreground="{StaticResource TextDimBrush}"
                 Text="{Binding Glyph}"
                 Visibility="{Binding ShowGlyph, Converter={StaticResource B2V}, FallbackValue=Visible}"/>

      <!-- Video play overlay -->
      <TextBlock Grid.Row="0"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontFamily="Segoe MDL2 Assets" FontSize="24"
                 Foreground="#CCFFFFFF"
                 Text="&#xE768;"
                 Visibility="{Binding IsVideo, Converter={StaticResource B2V}, FallbackValue=Collapsed}"/>

      <TextBlock Grid.Row="1"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 FontSize="11" TextTrimming="CharacterEllipsis"
                 HorizontalAlignment="Center" TextAlignment="Center"
                 Margin="0,4,0,0"
                 Text="{Binding Name}"/>
    </Grid>
  </Border>
</UserControl>
