<UserControl x:Class="FileVault.UI.Views.VaultIconRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:FileVault.UI.Models">
  <Grid Background="{StaticResource Surface1Brush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ItemsControl Grid.Row="0" x:Name="VaultList">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type models:VaultInfo}">
          <Button Style="{StaticResource RailButton}"
                  Click="VaultButton_Click" Tag="{Binding}"
                  ToolTip="{Binding DisplayName}">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Edit settings…" Click="EditSettings_Click" Tag="{Binding}"/>
                <MenuItem Header="Change password…" Click="ChangePassword_Click" Tag="{Binding}"/>
                <Separator/>
                <MenuItem Header="Lock vault" Click="LockVault_Click" Tag="{Binding}"/>
              </ContextMenu>
            </Button.ContextMenu>
            <TextBlock Text="{Binding Initial}"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="16" FontWeight="SemiBold"/>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <Button x:Name="AddButton"
              Style="{StaticResource RailButton}"
              Click="Add_Click"
              ToolTip="Add vault">
        <Button.ContextMenu>
          <ContextMenu x:Name="AddMenu" Placement="Top">
            <MenuItem Header="Create new vault…" Click="CreateVault_Click"/>
            <MenuItem Header="Open existing vault…" Click="OpenVault_Click"/>
          </ContextMenu>
        </Button.ContextMenu>
        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                   Foreground="{StaticResource TextMutedBrush}"
                   FontSize="14"/>
      </Button>
    </Border>
  </Grid>
</UserControl>
