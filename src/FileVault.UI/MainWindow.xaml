<Window x:Class="FileVault.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FileVault.UI.Views"
        Title="FileVault"
        Width="1200" Height="800"
        MinWidth="720" MinHeight="480">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="44"/>
      <ColumnDefinition Width="160" MinWidth="0"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Icon Rail -->
    <Border Grid.Column="0"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <views:VaultIconRail x:Name="IconRail"/>
    </Border>

    <!-- Folder Panel -->
    <Border Grid.Column="1"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <views:FolderPanel x:Name="FolderPanelView"/>
    </Border>

    <!-- Content Area + overlays -->
    <Grid Grid.Column="2">
      <views:ContentArea x:Name="ContentAreaView"/>
      <views:LockScreen x:Name="LockScreenView" Visibility="Collapsed"/>
      <views:MediaViewerOverlay x:Name="ViewerOverlay" Visibility="Collapsed"/>
    </Grid>
  </Grid>
</Window>
